# Copy this file to .env on the deployment host and replace every secret value.
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
IDENTITY_DB_PASSWORD=replace-with-strong-identity-password
FORUM_DB_PASSWORD=replace-with-strong-forum-password
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
NACOS_BIND_ADDRESS=127.0.0.1
NACOS_PORT=8848
NACOS_MEMORY_LIMIT=384m
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=18080
APP_MEMORY_LIMIT=384m
MYSQL_MEMORY_LIMIT=768m
REDIS_MEMORY_LIMIT=128m
JWT_SECRET=replace-with-at-least-32-bytes-secret
INTERNAL_SERVICE_TOKEN=replace-with-strong-internal-token
